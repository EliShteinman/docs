# Airgap mirror sync — deployment configuration.
#
# Copy this file to `mirrors.conf` (in the same directory) and edit values
# below to match your environment. The real `mirrors.conf` is gitignored.
#
# ALL settings here are deployment-specific (host names, group paths,
# filesystem locations, tokens). The list of upstream GitHub repos itself
# is identical to the catalog in helm/redis-docs/files/external-links.yaml
# (`git-mirrors:` section) — keep them in sync if you add/remove repos.

# ────────────────────────────────────────────────────────────────────────
# Mirrors directory — bare clones live here on BOTH machines.
# Each repo at: $MIRRORS_DIR/<name>.git
# ────────────────────────────────────────────────────────────────────────
MIRRORS_DIR="${HOME}/mirrors"

# ────────────────────────────────────────────────────────────────────────
# Transfer directory — bundles + release JSON + assets land here.
# On the EXTERNAL (online) machine: where outputs are written.
# On the INTERNAL (airgap) machine: where USB contents are read from.
# Set per-machine in your local mirrors.conf — the path differs.
# ────────────────────────────────────────────────────────────────────────
TRANSFER_DIR="${HOME}/usb-transfer"

# ────────────────────────────────────────────────────────────────────────
# GitLab API target (INTERNAL machine only — leave empty on external).
# GITLAB_TOKEN should come from the environment, never the config file.
# ────────────────────────────────────────────────────────────────────────
GITLAB_HOST="https://gitlab.your-company.example"
# export GITLAB_TOKEN before running internal scripts:
#   export GITLAB_TOKEN="glpat-xxxxx"

# ────────────────────────────────────────────────────────────────────────
# Mirror catalog — name | github_owner/repo | gitlab_path
#
# `name`           — local mirror folder name ($MIRRORS_DIR/<name>.git)
#                    AND the key under externalLinks.gitMirrors in values.yaml
# `github_owner/repo` — upstream GitHub URL is https://github.com/<this>
# `gitlab_path`    — destination project path inside GitLab (no host)
#                    nested groups OK: "redis/k8s/redis-enterprise-k8s-docs"
# ────────────────────────────────────────────────────────────────────────
MIRRORS=(
  "k8s-docs|RedisLabs/redis-enterprise-k8s-docs|your-group/redis-enterprise-k8s-docs"
  "observability|redis-field-engineering/redis-enterprise-observability|your-group/redis-enterprise-observability"
  "redis|redis/redis|your-group/redis"
  "RediSearch|RediSearch/RediSearch|your-group/RediSearch"
  "RedisGraph|RedisGraph/RedisGraph|your-group/RedisGraph"
  "RedisInsight|RedisInsight/RedisInsight|your-group/RedisInsight"
  "RedisTimeSeries|RedisTimeSeries/RedisTimeSeries|your-group/RedisTimeSeries"
  "RedisGears|RedisGears/RedisGears|your-group/RedisGears"
  "RedisJSON|RedisJSON/RedisJSON|your-group/RedisJSON"
  "RedisBloom|RedisBloom/RedisBloom|your-group/RedisBloom"
  "redis-py|redis/redis-py|your-group/redis-py"
  "prometheus-operator|prometheus-operator/prometheus-operator|your-group/prometheus-operator"
)
