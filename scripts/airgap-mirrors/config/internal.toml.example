# Air-gapped machine (the one next to GitLab). Copy to internal.toml and set gitlab_url and gitlab_group.
# The only place that describes the internal network.
#
# The GitLab token is never written here. Before each run:
#   export GITLAB_TOKEN=<access token with the api scope, Maintainer of gitlab_group>

# The local copy of every repository is kept here between runs.
mirrors_dir = "~/airgap/mirrors"
# Where the USB stick's transfer folder was copied to.
transfer_dir = "~/airgap/transfer"

gitlab_url = "https://gitlab.<your-company>.example"

# The group every copy goes into: <gitlab_group>/<repository name>, e.g. redis/mirrors/redis.
# The group must exist; missing subgroups inside it and every project are created on the first import.
# Which repositories to import is read from the transfer folder, so there is no list to keep here.
gitlab_group = "<your-group>/mirrors"

# Visibility of the projects (and subgroups) this tool creates: "private", "internal" or "public".
# Leave out to use GitLab's default. It cannot be wider than the group's own visibility.
# project_visibility = "internal"

# Leave out to push over HTTPS with the token. Set to push over SSH instead.
# git_remote_base = "ssh://git@gitlab.<your-company>.example"

# Your company's certificate authority, if GitLab's certificate is not trusted by default.
# ca_file = "/etc/pki/tls/certs/company-ca.pem"

release_package_name = "release-assets"
http_timeout_seconds = 600

# Only to put one repository somewhere other than <gitlab_group>/<name>:
# [[repos]]
# name = "redis"
# gitlab_path = "other-group/redis-server"
