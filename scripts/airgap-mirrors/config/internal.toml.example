# Air-gapped machine (the one next to GitLab). Copy to internal.toml and edit.
# The only place that describes the internal network.
#
# The GitLab token is never written here. Before each run:
#   export GITLAB_TOKEN=<personal access token with the api scope>

# The local copy of every repository is kept here between runs.
mirrors_dir = "/home/<user>/airgap/mirrors"
# Where the USB stick's transfer folder was copied to.
transfer_dir = "/home/<user>/airgap/transfer"

gitlab_url = "https://gitlab.<your-company>.example"
# Leave out to push over HTTPS with the token. Set to push over SSH instead, e.g. "ssh://git@gitlab.<your-company>.example".
# git_remote_base = "ssh://git@gitlab.<your-company>.example"
# Your company's certificate authority, if GitLab's certificate is not trusted by default.
# ca_file = "/etc/pki/tls/certs/company-ca.pem"
release_package_name = "release-assets"
http_timeout_seconds = 600

# One block per repository: the GitLab project it goes to (group/subgroup/project).
# The project must exist and be empty (no README) before the first import.

[[repos]]
name = "redis"
gitlab_path = "<your-group>/redis"

[[repos]]
name = "RediSearch"
gitlab_path = "<your-group>/RediSearch"

