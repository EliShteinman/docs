# Online machine (the one with internet). Copy to external.toml and edit the two folders.
# Nothing here may describe the internal network: no GitLab address, no group names, no tokens.
#
# A GitHub token is optional but raises GitHub's rate limit from 60 to 5,000 calls an hour:
#   export GITHUB_TOKEN=<token>        (or: export GITHUB_TOKEN=$(gh auth token))

# A copy of every repository is kept here between runs. It is what makes the next transfer small.
mirrors_dir = "~/airgap/mirrors"
# The folder that goes on the USB stick.
transfer_dir = "~/airgap/transfer"

github_url = "https://github.com"
github_api_url = "https://api.github.com"
# A request that sends nothing for this long is dropped. A dropped download is tried again,
# up to download_attempts times in all.
http_timeout_seconds = 120
download_attempts = 4

# Release files. Release notes always come; these decide which files come with them.
#
#   default_assets     which releases get their files downloaded:
#                        "latest-per-type"  the newest stable release, plus the newest pre-release
#                                           (rc, beta, ...) when it is newer than that stable one
#                        "latest-stable"    the newest stable release only, no pre-releases
#                        "none"             no files
#                        "all"              every release (can be many GB)
#                        "latest:N"         the N newest releases
#                        "since:YYYY-MM-DD" releases from that date on
#   default_platforms  which platforms' files: "windows", "linux" (deb, AppImage, snap),
#                      "redhat" (rpm, el8/el9/el10), "amazon", "macos".
#                      Files that name no platform (source archives, jars, YAML) always come.
#                      Leave empty for every platform.
#   default_architectures  which processors' files: "x86_64", "arm64", "arm32", "x86_32".
#                      Files that name no processor (a Windows installer, a script) always come.
#
# "Type" in latest-per-type is the tag's prefix and stable versus pre-release: redis/redisctl ships
# redisctl-v*, redisctl-mcp-v* and redisctl-core-v*, so each of the three gets its newest release.
default_assets = "latest-per-type"
default_platforms = ["windows", "linux", "redhat"]
default_architectures = ["x86_64"]
# Files never downloaded, by the end of their name. The internal network's intake refuses
# signature files (PGP and similar) as encrypted, so they stay out of every repository.
excluded_asset_suffixes = [".asc", ".sig", ".gpg", ".pgp", ".p7s", ".minisig"]

# One block per repository. The names must stay the same as in internal.toml and in
# helm/redis-docs/files/external-links.yaml (git-mirrors).
# A block may override the defaults with its own `assets` and `platforms`, and narrow further with
# `asset_filter`: only files whose name contains one of these words.
# `extra_files`: files the repository needs but does not keep in git (a model its build downloads, say).
# Each one is downloaded to <transfer>/extra/<name>/<path>, sent once, and sent again when its url changes.

[[repos]]
name = "redis"
github = "redis/redis"

[[repos]]
name = "RediSearch"
github = "RediSearch/RediSearch"

[[repos]]
name = "RedisJSON"
github = "RedisJSON/RedisJSON"

[[repos]]
name = "RedisTimeSeries"
github = "RedisTimeSeries/RedisTimeSeries"

[[repos]]
name = "RedisBloom"
github = "RedisBloom/RedisBloom"

[[repos]]
name = "RedisGears"
github = "RedisGears/RedisGears"

[[repos]]
name = "RedisGraph"
github = "RedisGraph/RedisGraph"

[[repos]]
name = "RedisInsight"
github = "redis/RedisInsight"

[[repos]]
name = "k8s-docs"
github = "RedisLabs/redis-enterprise-k8s-docs"

[[repos]]
name = "observability"
github = "redis-field-engineering/redis-enterprise-observability"

[[repos]]
name = "prometheus-operator"
github = "prometheus-operator/prometheus-operator"

[[repos]]
name = "docs"
github = "redis/docs"

[[repos]]
name = "redis-py"
github = "redis/redis-py"

[[repos]]
name = "redis-vl-python"
github = "redis/redis-vl-python"

[[repos]]
name = "jedis"
github = "redis/jedis"

[[repos]]
name = "lettuce"
github = "redis/lettuce"

[[repos]]
name = "node-redis"
github = "redis/node-redis"

[[repos]]
name = "ioredis"
github = "redis/ioredis"

[[repos]]
name = "go-redis"
github = "redis/go-redis"

[[repos]]
name = "rueidis"
github = "redis/rueidis"

[[repos]]
name = "NRedisStack"
github = "redis/NRedisStack"

[[repos]]
name = "hiredis"
github = "redis/hiredis"

[[repos]]
name = "predis"
github = "predis/predis"

[[repos]]
name = "redis-om-python"
github = "redis/redis-om-python"

[[repos]]
name = "redis-om-node"
github = "redis/redis-om-node"

[[repos]]
name = "redis-om-spring"
github = "redis/redis-om-spring"

[[repos]]
name = "redis-om-dotnet"
github = "redis/redis-om-dotnet"
# The Vectorizers projects embed these models, but git holds none of them: upstream downloads them with
# fetch-models.sh. Without them the two Vectorizers projects do not build.
extra_files = [
  { url = "https://storage.googleapis.com/slorello/model.onnx", path = "src/Redis.OM.Vectorizers.AllMiniLML6V2/Resources/model.onnx" },
  { url = "https://storage.googleapis.com/slorello/vocab.txt", path = "src/Redis.OM.Vectorizers.AllMiniLML6V2/Resources/vocab.txt" },
  { url = "https://storage.googleapis.com/slorello/ResNet18.onnx", path = "src/Redis.OM.Vectorizers.Resnet18/Resources/ResNet18Onnx/ResNet18.onnx" },
  { url = "https://storage.googleapis.com/slorello/ResNetPreprocess.onnx", path = "src/Redis.OM.Vectorizers.Resnet18/Resources/ResNetPrepOnnx/ResNetPreprocess.onnx" },
]

[[repos]]
name = "memtier_benchmark"
github = "redis/memtier_benchmark"

[[repos]]
name = "redisctl"
github = "redis/redisctl"

[[repos]]
name = "redis-apache-arrow-flight"
github = "redis/redis-apache-arrow-flight"

[[repos]]
name = "redis-adbc-driver"
github = "redis/redis-adbc-driver"

[[repos]]
name = "redisinsight-tutorials"
github = "redis/Tutorials"

[[repos]]
name = "riotx"
github = "redis/riotx-dist"
# Every RIOT-X file is about 390 MB (each bundles Java), and "early-access" is a rolling build:
# take the stable release's self-contained Linux and Windows builds only.
assets = "latest-stable"
asset_filter = ["linux-x86_64", "windows"]

[[repos]]
name = "grafana-redis-datasource"
github = "RedisGrafana/grafana-redis-datasource"
