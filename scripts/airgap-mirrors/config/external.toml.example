# Online machine (the one with internet). Copy to external.toml and edit the two folders.
# Nothing here may describe the internal network: no GitLab address, no group names, no tokens.
#
# A GitHub token is optional but raises GitHub's rate limit from 60 to 5,000 calls an hour:
#   export GITHUB_TOKEN=<token>        (or: export GITHUB_TOKEN=$(gh auth token))

# A copy of every repository is kept here between runs. It is what makes the next transfer small.
mirrors_dir = "/home/<user>/airgap/mirrors"
# The folder that goes on the USB stick.
transfer_dir = "/home/<user>/airgap/transfer"

github_url = "https://github.com"
github_api_url = "https://api.github.com"
http_timeout_seconds = 120

# Release files. Release notes always come; these decide which files come with them.
#
#   default_assets     which releases get their files downloaded:
#                        "latest-per-type"  the newest stable release, plus the newest pre-release
#                                           (rc, beta, ...) when it is newer than that stable one
#                        "none"             no files
#                        "all"              every release (can be many GB)
#                        "latest:N"         the N newest releases
#                        "since:YYYY-MM-DD" releases from that date on
#   default_platforms  which platforms' files: "windows", "linux" (deb, AppImage, snap),
#                      "redhat" (rpm, el8/el9/el10), "amazon", "macos".
#                      Files that name no platform (source archives, jars, YAML) always come.
#                      Leave empty for every platform.
default_assets = "latest-per-type"
default_platforms = ["windows", "linux", "redhat"]

# One block per repository. The names must stay the same as in internal.toml and in
# helm/redis-docs/files/external-links.yaml (git-mirrors).
# A block may override the defaults with its own `assets` and `platforms`, and narrow further with
# `asset_filter`: only files whose name contains one of these words.

[[repos]]
name = "redis"
github = "redis/redis"

[[repos]]
name = "RediSearch"
github = "RediSearch/RediSearch"

[[repos]]
name = "RedisJSON"
github = "RedisJSON/RedisJSON"

